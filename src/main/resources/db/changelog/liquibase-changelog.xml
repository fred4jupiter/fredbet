<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Binary and text content is stored inline in the table. On PostgreSQL, BLOB and CLOB would be created as
        large objects (oid), which are not removed together with their row.
    -->
    <property name="binary_type" value="bytea" dbms="postgresql"/>
    <property name="binary_type" value="blob" dbms="h2"/>
    <property name="text_type" value="text" dbms="postgresql"/>
    <property name="text_type" value="clob" dbms="h2"/>

    <changeSet id="initial-schema" author="michael">
        <comment>initial schema, replaces the former changesets 1 to 24</comment>

        <createTable tableName="app_user">
            <column name="user_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_app_user" nullable="false"/>
            </column>
            <column name="user_name" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_app_user_user_name"/>
            </column>
            <column name="password" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="last_login" type="datetime"/>
            <column name="deletable" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="is_child" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="first_login" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="setting_theme" type="varchar(20)" defaultValue="white">
                <constraints nullable="false"/>
            </column>
            <column name="setting_bootswatch_theme" type="varchar(20)" defaultValue="DEFAULT">
                <constraints nullable="false"/>
            </column>
            <column name="setting_navbar_layout" type="varchar(20)" defaultValue="DARK">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="user_roles">
            <column name="user_id" type="bigint">
                <constraints foreignKeyName="fk_user_roles_user" references="app_user(user_id)"/>
            </column>
            <column name="role" type="varchar(100)"/>
        </createTable>

        <!-- remember me tokens of spring security -->
        <createTable tableName="persistent_logins">
            <column name="series" type="varchar(64)">
                <constraints primaryKey="true" primaryKeyName="pk_persistent_logins" nullable="false"/>
            </column>
            <column name="username" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="last_used" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="session_tracking">
            <column name="user_name" type="varchar(100)">
                <constraints primaryKey="true" primaryKeyName="pk_session_tracking" nullable="false"/>
            </column>
            <column name="session_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_login" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="team">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_team" nullable="false"/>
            </column>
            <column name="team_type" type="varchar(20)"/>
            <column name="team_key" type="varchar(100)"/>
            <column name="name" type="varchar(100)">
                <constraints unique="true" uniqueConstraintName="uc_team_name"/>
            </column>
            <column name="svg_content" type="${text_type}"/>
            <column name="favourite" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="team" columnNames="team_type, team_key" constraintName="uc_team_type_key"/>

        <createTable tableName="matches">
            <column name="match_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_matches" nullable="false"/>
            </column>
            <column name="team_one_id" type="bigint">
                <constraints foreignKeyName="fk_matches_team_one" references="team(id)"/>
            </column>
            <column name="team_two_id" type="bigint">
                <constraints foreignKeyName="fk_matches_team_two" references="team(id)"/>
            </column>
            <column name="goals_team_one" type="int"/>
            <column name="goals_team_two" type="int"/>
            <column name="penalty_winner_one" type="boolean" defaultValueBoolean="false"/>
            <column name="match_group" type="varchar(100)"/>
            <column name="kick_off_date" type="datetime"/>
            <column name="stadium" type="varchar(100)"/>
            <column name="external_id" type="varchar(100)"/>
            <column name="external_last_updated" type="datetime"/>
            <column name="create_date" type="datetime"/>
            <column name="update_date" type="datetime"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="updated_by" type="varchar(50)"/>
        </createTable>
        <createIndex tableName="matches" indexName="idx_matches_external_id">
            <column name="external_id"/>
        </createIndex>

        <createTable tableName="bet">
            <column name="bet_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_bet" nullable="false"/>
            </column>
            <column name="user_name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="match_id" type="bigint">
                <constraints foreignKeyName="fk_bet_match" references="matches(match_id)"/>
            </column>
            <column name="goals_team_one" type="int"/>
            <column name="goals_team_two" type="int"/>
            <column name="penalty_winner_one" type="boolean" defaultValueBoolean="false"/>
            <column name="points" type="int"/>
            <column name="joker" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="bet" columnNames="user_name, match_id" constraintName="uc_bet_user_match"/>
        <createIndex tableName="bet" indexName="idx_bet_user_name">
            <column name="user_name"/>
        </createIndex>

        <createTable tableName="extra_bet">
            <column name="extra_bet_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_extra_bet" nullable="false"/>
            </column>
            <column name="user_name" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_extra_bet_user_name"/>
            </column>
            <column name="final_winner_team_id" type="bigint">
                <constraints foreignKeyName="fk_extra_bet_final_winner_team" references="team(id)"/>
            </column>
            <column name="semi_final_winner_team_id" type="bigint">
                <constraints foreignKeyName="fk_extra_bet_semi_final_winner_team" references="team(id)"/>
            </column>
            <column name="third_final_winner_team_id" type="bigint">
                <constraints foreignKeyName="fk_extra_bet_third_final_winner_team" references="team(id)"/>
            </column>
            <column name="points_one" type="int"/>
            <column name="points_two" type="int"/>
            <column name="points_three" type="int"/>
        </createTable>

        <createTable tableName="info_content">
            <column name="info_name" type="varchar(100)">
                <constraints primaryKey="true" primaryKeyName="pk_info_content" nullable="false"/>
            </column>
            <column name="locale_string" type="varchar(10)">
                <constraints primaryKey="true" primaryKeyName="pk_info_content" nullable="false"/>
            </column>
            <column name="content" type="${text_type}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="image_group">
            <column name="image_group_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_image_group" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_image_group_name"/>
            </column>
            <column name="user_profile_img_group" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="image_meta_data">
            <column name="image_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_image_meta_data" nullable="false"/>
            </column>
            <column name="image_key" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_image_meta_data_image_key"/>
            </column>
            <column name="image_group_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_image_metadata_image_group" references="image_group(image_group_id)"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_image_metadata_user" references="app_user(user_id)"/>
            </column>
            <column name="description" type="varchar(400)"/>
            <column name="version" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- the content of the images, only used if the images are stored in the database -->
        <createTable tableName="image_binary">
            <column name="image_key" type="varchar(100)">
                <constraints primaryKey="true" primaryKeyName="pk_image_binary" nullable="false"/>
            </column>
            <column name="image_bytes" type="${binary_type}">
                <constraints nullable="false"/>
            </column>
            <column name="thumb_image_bytes" type="${binary_type}"/>
            <column name="version" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="runtime_setting">
            <column name="config_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_runtime_setting" nullable="false"/>
            </column>
            <column name="json_config" type="varchar(2000)"/>
            <column name="version" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
